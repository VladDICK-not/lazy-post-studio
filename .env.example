# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Master Security Key (Password to enter your studio)
ADMIN_PASSWORD=your_super_secret_password_here
# Secret for cron trigger (e.g. cron-job.org calls https://your-site.vercel.app/api/cron/publish?key=your_cron_secret)
CRON_SECRET=your_random_cron_secret_key

# Telegram Settings
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_CHANNEL_ID=@your_channel_or_chat_id
# Your personal Telegram chat ID for admin notifications (get it from @userinfobot)
TELEGRAM_ADMIN_CHAT_ID=123456789

# Threads API Settings (Meta for Developers)
THREADS_USER_ID=your_threads_user_id
THREADS_ACCESS_TOKEN=your_long_lived_threads_token
